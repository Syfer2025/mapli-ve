{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Configs de raiz e scripts de tooling. Rodam em Node, fora do grafo de pacotes.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["vitest.config.ts", "tools/**/*.ts"]
}
