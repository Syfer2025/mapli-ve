{
  "name": "theatrum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Theatrum",
  "packageManager": "pnpm@11.17.0",
  "description": "Plataforma de animação geopolítica e militar. Local, offline.",
  "main": "out/main/index.mjs",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "predev": "pnpm data:verify",
    "dev": "electron-vite dev",
    "prebuild": "pnpm data:verify",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "data:fetch": "node tools/fetch-data.ts",
    "data:verify": "node tools/fetch-data.ts --verify",
    "satellite:hormuz": "tsx tools/fetch-regional-satellite.ts",
    "satellite:hormuz:verify": "tsx tools/fetch-regional-satellite.ts --verify",
    "geo:build": "tsx tools/build-geo.ts",
    "geo:verify": "tsx tools/build-geo.ts --verify",
    "models:textures": "node tools/extract-model-textures.ts",
    "models:index": "node tools/build-model-index.ts",
    "models:verify": "node tools/build-model-index.ts --verify",
    "schema:gen": "tsx tools/gen-schema.ts",
    "verify:phase2": "node tools/verify-phase2.mjs",
    "verify:phase3": "node tools/verify-phase3.mjs",
    "verify:phase4": "node tools/verify-phase4.mjs",
    "verify:phase5": "node tools/verify-phase5.mjs",
    "verify:phase6": "node tools/verify-phase6.mjs",
    "verify:phase7a": "node tools/verify-phase7a.mjs",
    "verify:phase7b": "node tools/verify-phase7b.mjs",
    "verify:phase7c": "node tools/verify-phase7c.mjs",
    "verify:phase7d": "node tools/verify-phase7d.mjs",
    "verify:phase7e3": "node tools/verify-phase7e3.mjs",
    "verify:phase8-video": "node tools/verify-phase8-video.mjs",
    "verify:phase8-formats": "node tools/verify-phase8-formats.ts",
    "verify:phase8": "node tools/verify-phase8.mjs",
    "sidecar:prepare": "node tools/prepare-ffmpeg-sidecar.ts",
    "examples:build": "node --require ./tools/node-userinfo-shim.cjs --import tsx tools/build-examples.ts",
    "dist:dir": "pnpm build && pnpm examples:build && pnpm sidecar:prepare && electron-builder --win --x64 --dir",
    "dist:win": "pnpm build && pnpm examples:build && pnpm sidecar:prepare && electron-builder --win nsis --x64",
    "typecheck": "pnpm typecheck:src && pnpm typecheck:test && pnpm typecheck:node && pnpm typecheck:apps",
    "typecheck:src": "tsc -b --pretty",
    "typecheck:test": "tsc -p tsconfig.test.json --pretty",
    "typecheck:node": "tsc -p tsconfig.node.json --pretty",
    "typecheck:apps": "tsc -p apps/shell/tsconfig.json --pretty && tsc -p apps/editor/tsconfig.json --pretty",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "lint:arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts --reporter=verbose",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "check": "pnpm data:verify && pnpm geo:verify && pnpm typecheck && pnpm lint && pnpm lint:arch && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.theatrum.editor",
    "productName": "Theatrum",
    "copyright": "Copyright © 2026 Theatrum",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      },
      {
        "from": "build/ffmpeg/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "examples",
        "to": "examples"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.svg",
      "artifactName": "Theatrum-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Theatrum",
      "uninstallDisplayName": "Theatrum",
      "deleteAppDataOnUninstall": false
    }
  }
}
