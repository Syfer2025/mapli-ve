# dependências e build
node_modules/
dist/
out/
release/
.vite/
*.tsbuildinfo

# geodados offline — baixados e verificados por tools/fetch-data.ts
data/basemap/*.pmtiles
data/glyphs/
data/natural-earth/*.geojson
data/sprites/
data/raster/
data/terrain/
# malha compilada por tools/build-geo.ts — derivada da origem fixada por hash
data/geo/

# Biblioteca 3D local do usuário: raízes nomeadas apontando para fora do
# repositório, e o índice derivado delas. Gigabytes de GLB não entram no
# controle de versão nem viajam para o remoto.
data/library-roots.json
data/models-index.json

# saída de teste
coverage/
artifacts/
exports/
tests/golden/frames/*.actual.png
tests/golden/frames/*.diff.png
.tmp-*

# recuperação e jobs
*.theatrum-recovery
.theatrum-jobs/

# sistema
.DS_Store
Thumbs.db
desktop.ini

# medições e provas de bancada locais (ex.: scratchpad/measure-roads.ts do ADR-011)
scratchpad/

# sidecars binários preparados localmente para o empacotamento
build/ffmpeg/*.exe
