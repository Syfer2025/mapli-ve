{
  "$comment": "GERADO por tools/scaffold.mjs a partir da tabela de camadas. Não editar.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.bench.ts"],
  "references": [
    {
      "path": "../renderer"
    },
    {
      "path": "../scene-graph"
    },
    {
      "path": "../schema"
    },
    {
      "path": "../core-math"
    },
    {
      "path": "../core-time"
    },
    {
      "path": "../core-utils"
    }
  ]
}
